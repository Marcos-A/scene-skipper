{
  "manifest_version": 3,
  "name": "Scene Skipper",
  "version": "1.0.0",
  "description": "Automatically click Netflix’s Skip Intro and Skip Recap buttons.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Scene Skipper",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{
    "matches": ["https://www.netflix.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
